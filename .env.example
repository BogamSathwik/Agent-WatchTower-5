# ==============================================================================
# Agent Watchtower — Unified Environment Configuration Template
# Copy this file to .env and configure settings for your environment.
# Zero hardcoding: all services, network bindings, and databases read from here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_HOST=localhost
FRONTEND_PORT=5000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# Persistence mode: memory | mysql
PERSISTENCE_MODE=memory

# MySQL Connection (Required when PERSISTENCE_MODE=mysql)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_DATABASE=

# ------------------------------------------------------------------------------
# 3. Application State Store Namespacing (agent_data table)
# ------------------------------------------------------------------------------
STORE_TABLE=agent_data
STORE_USER_ID=0
STORE_FIRM_ID=5
STORE_NAME=AgentWatchtower
STORE_COLLECTION_PREFIX=wt_
AUTO_RESTORE=true

# ------------------------------------------------------------------------------
# 4. External Agent & Adapter Endpoints
# ------------------------------------------------------------------------------
COMPA_AGENT_URL=https://myblocks.in/compa-agent/
REPA_AGENT_URL=http://myblocks.in/repa-agent/REPA_Agent.html
TEST_AGENT_URL=http://localhost:4001
AGENT_CONNECT_TIMEOUT_MS=5000
AGENT_READ_TIMEOUT_MS=8000
AGENT_MAX_RETRIES=2
AGENT_RETRY_DELAY_MS=1000

# ------------------------------------------------------------------------------
# 5. Security & Platform Configuration
# ------------------------------------------------------------------------------
PLATFORM_NAME=Universal Monitoring & Intelligence Platform
PLATFORM_VERSION=15.0.0
REQUIRE_AUTH=false
PLATFORM_API_KEY=

# ------------------------------------------------------------------------------
# 6. Observability, Audit & Operations
# ------------------------------------------------------------------------------
TELEMETRY_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PATH=/api/v1/telemetry/metrics
TENANT_MODE=SINGLE_AND_MULTI_TENANT
DEFAULT_TENANT=default-tenant
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_RECORDS=5000
ALERTING_ENABLED=true
MAX_ESCALATION_LEVEL=3
REMEDIATION_POLICY_MODE=APPROVAL_REQUIRED
REMEDIATION_DRY_RUN=true
